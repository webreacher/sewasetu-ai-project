# ==========================================
# Large Artifacts & Heavy Legacy Data
# ==========================================
# Exclude audio briefing and archive packages
*.mp3
*.wav
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Exclude raw server log dumps & runtime logs
*.log
logs/
server_logs/
/var/log/
/var/sewasetu/

# Database dumps and large seed data files (>50MB)
*.dump
*.sql.gz
*.sqlite3
*.db
seed/*.csv
seed/*.json
seed/*.dump

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
.venv*/
venv/
ENV/
env/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets/
app/config/*.local.ini

# ==========================================
# Docker & Uploads
# ==========================================
uploads/
/var/sewasetu/uploads/
.docker/

# ==========================================
# IDE & Operating System Files
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db
Desktop.ini